# Kamojiros Notes Repository Root (Required)
# Path to the local git repository where notes/reports are stored.
KAMOJIROS_NOTES__REPO_ROOT=/path/to/your/notes_repo

# Misskey Settings (Required)
KAMOJIROS_MISSKEY__HOST=https://misskey.io
KAMOJIROS_MISSKEY__ACCESS_TOKEN=your_misskey_api_token
KAMOJIROS_MISSKEY__KAMOJIROID_ID=your_kamojiroid_id

# Google Gemini Settings (Required)
KAMOJIROS_GEMINI__PROJECT_ID=your-gcp-project-id
KAMOJIROS_GEMINI__API_KEY=your-gemini-api-key

# PostgreSQL Settings (Required)
KAMOJIROS_POSTGRES__HOST=localhost
KAMOJIROS_POSTGRES__PORT=5432
KAMOJIROS_POSTGRES__DATABASE=kamojiros
KAMOJIROS_POSTGRES__USER=postgres
KAMOJIROS_POSTGRES__PASSWORD=password
# Optional:
# KAMOJIROS_POSTGRES__ACTIVITY_INDEX_NAME=activity_index

# SearxNG Settings (Optional)
KAMOJIROS_SEARXNG__BASE_URL=http://localhost:8080

# Self Observer Settings (Optional)
# Timezone for daily reports (default: Asia/Tokyo)
KAMOJIROS_SELF_OBSERVER__TIMEZONE=Asia/Tokyo

# State Store Settings (Optional)
# KAMOJIROS_STATE_STORE__BASE_DIR=./.kamojiros
