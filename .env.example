# Kamojiros Notes Repository Root (Required)
# Path to the local git repository where notes/reports are stored.
KAMOJIROS_NOTES__REPO_ROOT=/path/to/your/notes_repo

# Self Observer Settings (Optional)
# Timezone for daily reports (default: Asia/Tokyo)
KAMOJIROS_SELF_OBSERVER__TIMEZONE=Asia/Tokyo

# Tracker Settings (Optional)
# Base URL for the tracker service (default: https://example.com)
KAMOJIROS_TRACKER__BASE_URL=https://example.com

# Misskey Settings (Optional)
# Required for Misskey Ingestor and Self Observer to fetch activities.
MISSKEY_URL=https://misskey.io
MISSKEY_TOKEN=your_misskey_api_token
